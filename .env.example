# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control and NEVER put secrets in frontend code.

# Database connection. Copy config/database.php.example to config/database.php.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_exam_system
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Official OpenAI API key (server-side only).
OPENAI_API_KEY=

# Optional: override the model used for difficult question generation.
# Defaults to gpt-4o-mini when left blank.
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI API base URL (defaults to https://api.openai.com/v1).
OPENAI_API_BASE=https://api.openai.com/v1
